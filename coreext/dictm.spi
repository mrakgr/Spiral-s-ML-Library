// Provides an interface to the C++ `unordered_map`.

open corebase

inl globals() = global "#include <unordered_map>"

nominal dict k v = $"std::unordered_map<`k, `v, `(fptr (arg k) int), `(fptr (arg k * arg k) bool)>"

inl create forall k v. (buckets : int) : dict k v =
    globals()
    $"std::unordered_map<`k, `v, `(fptr (arg k) int), `(fptr (arg k * arg k) bool)> \v(!buckets, !(to_fptr hash : fptr (arg k) int), !(to_fptr (fun a,b => a = b) : fptr (arg k * arg k) bool))"

// Gets an item from the dictionary.
inl get forall k v. (d : dict k v) (k : k) : option v =
    inl it : $"auto" = $"auto \v = !d.find(!k)"
    if $"!it !!= !d.end()" then Some $"!it->second" else None
// Sets the item to the dictionary at the specified key.
inl set forall k v. (d : dict k v) (k : k) (v : v) : () = $"!d[!k] = !v"
// Checks whether the key exists in the dictionary.
inl contains forall k v. (d : dict k v) (k : k) : bool = $"!d.contains(!k)"
// Clears the dictionary of keys.
inl clear forall k v. (d : dict k v) : () = $"!d.clear()"
// Removes the key from the dictionary and returns boolean whether the operation was successful.
inl erase forall k v. (d : dict k v) (k : k) : bool = $"static_cast<bool>(!d.erase(!k))"
// Iterates over the dictionary with the iterator function.
inl iter forall k v. (f : k -> v -> ()) (d : dict k v) : () =
    inl d = corecuda.refm.from_local d
    inl it : $"`(dict k v)::iterator &" = $"auto \v = !d.begin()"
    loop.while' (fun () => $"!it !!= !d.end()") fun () =>
        f $"!it->first" $"!it->second"
        $"++!it"

inl test0() =
    globals()
    inl d : dict (i32 * bool) string =  create 8
    set d (1, true) "Hello"
    set d (2, false) "World"
    console.write_ln (get d (1,true))
    console.write_ln (get d (2,false))
    console.write_ln (get d (3,true))
    
    console.write_ln (contains d (2,false))
    console.write_ln (contains d (3,true))

    console.write_ln ("Removing", erase d (2,false))
    console.write_ln ("Contains", contains d (2,false))

inl test1() =
    globals()
    inl d : dict i32 string = create 8
    set d 1 "Hello"
    set d 2 "World"
    set d 3 "!!!"
    iter (fun k v => console.write_ln (k,v)) d
    ()
    
        
inl main() =
    test1()
    0i32