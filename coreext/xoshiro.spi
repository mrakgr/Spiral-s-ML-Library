// Provides an interface to the Xoshiro RNG.
// Link: https://github.com/nessan/xoshiro

open corebase
open corecuda
open random

inl globals() = global "#include <xoshiro.h>"

nominal xoshiro_rng = $"xso::rng"
instance u32 xoshiro_rng = fun s => $"!s()"

inl create() : ref xoshiro_rng =
    globals()
    $"`xoshiro_rng \v"