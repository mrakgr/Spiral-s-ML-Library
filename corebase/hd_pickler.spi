// Pickler combinators for converting regular Spiral types to binary vectors of floating point values.
// The preferred pickler for Hopfield dictionaries. I'd also recomment it for regular NNs as well.

// Returns boolean whether the array is 1 at a given index.
prototype pickler_index array : array -> int -> bool
// Sets the array to 1 at the given index.
prototype pickler_set array : array -> int -> bool -> ()
prototype pickler_create array : int -> array

instance pickler_create array t = create
instance pickler_index array t{number} = fun x i => 
    if index x i = 1 then true
    elif index x i = 0 then false
    else failwith "Pickler index expected to get 1 or 0."
instance pickler_set array t{number} = fun x i v => set x i (if v then 1 else 0)
nominal binary_array = array u32

instance pickler_create binary_array = fun len => binary_array (create (divup len 32))
instance pickler_index binary_array = fun (binary_array (x : array u32)) i => 
    index x (i / 32) &&& (1 <<< (i % 32)) <> 0
instance pickler_set binary_array = fun (binary_array (x : array u32)) i v =>
    inl a = index x (i / 32)
    inl b = 1 <<< (i % 32)
    set x (i / 32) (if v then a ||| b else a &&& ~~~b)

union rec pickler t =
    | Unit :: pickler ()
    | Bool :: pickler bool
    | Int :: int -> pickler int
    | Uint :: int -> pickler uint
    | Sa_list :: forall dim t. pickler t -> pickler (sa_list dim t)
    | Sa :: forall dim t. pickler t -> pickler (sa dim t)
    | Pair :: forall a b. pickler a * pickler b -> pickler (a * b)
    | Wrap :: forall a. (exists b. (a -> b) * (b -> a) * pickler b) -> pickler a
    | Alt :: forall t. union_map pickler t -> pickler t

inl unit() = Unit
inl bool() = Bool
inl int x = Int x
inl uint x = Uint x
inl sa_list forall a b. (x : pickler a) : pickler (sa_list b a) = Sa_list x
inl sa forall a b. (x : pickler a) : pickler (sa b a) = Sa x
inl pair forall a b. (a : pickler a) (b : pickler b) : pickler (a * b) = Pair(a,b)

// Takes in a record of picklers and produces an alt node.
inl alt forall record_of_picklers union_. (picklers : record_of_picklers) : pickler union_ =
    Alt(real union_map `pickler `union_ picklers)

// Creates a new pickler out of existing ones using the bijection functions.
inl wrap forall a b. (in_ : a -> b) (out : b -> a) (p : pickler b) : pickler a = Wrap(exists in_, out, p)

// Gets the max length of a static array.
inl get_max_length forall (array : * -> * -> *) dim el. (x : pickler (array dim el)) : int = real real_core.type_lit_to_lit `dim : int

// Returns the number of entries in the pickler.
inl size' (h : compile_time.hashmap) : forall t. pickler t -> int = 
    inl body forall t. (p : pickler t) : int =
        inl rec loop forall t'. : pickler t' -> int =
            compile_time.hashmapm.memoize h function
                | Unit => 0
                | Bool => 2
                | Int l => l
                | Uint l => l 
                | Sa_list p as x => 
                    inl max_len = get_max_length x
                    max_len + (loop p + 1) * max_len
                | Sa p as x =>
                    inl max_len = get_max_length x
                    loop p * max_len
                | Pair(a,b) => loop a + loop b 
                | Wrap (exists b. a, b, p) => loop p 
                | Alt l => real
                    open real_core
                    inl l = nominal_strip l
                    record_fold (fun {state key value} => 
                        typecase `value with pickler ~t => 
                        state + loop `t value
                        ) (record_length l) l
        loop p
    `$body

// Returns the size of the pickler. Uses a compile time dictionary under the hood that gets created when the union arg is applied.
inl size () : forall t. pickler t -> int = size' (compile_time.hashmapm.create())

// Serializes the argument to a binary vector. The vector elements should all be set to 0 prior to being passed into this function.
inl pickle forall array{pickler_set} tt. (ar : array) (p : pickler tt) ~(x : tt) : () = join
    inl size : forall w. pickler w -> int = size()
    inl i = stack_mut (0 : int)
    inl enable i' = pickler_set ar (*i + i') true
    inl advance i' = i <- *i + i'
    inl push a b = enable a . advance b
    inl set i' = i <- i'
    inl rec loop' forall t. (p : pickler t) (x : t) : () = 
        match p with
        | Unit => ()
        | Bool => push (if x then 1 else 0) 2
        | Int l => 
            assert (l > 0) "The argument to Int must be greater than 0."
            assert (x < l) "The input to the pickler must be 0 or positive."
            assert (0 <= x) "The input to the pickler must be less than the specified length."
            push x l
        | Uint l =>
            inl x = conv x
            assert (l > 0) "The argument to Uint must be greater than 0."
            assert (x < l) "The input to the pickler must be 0 or positive."
            push x l
        | Sa_list l => 
            inl max_len = get_max_length p
            inl len = length x
            push len max_len
            arraym.iter (fun x => loop' l x . advance 1) x
            loop.for' {from=len; nearTo=max_len} fun i =>
                advance (size l) . push 0 1
        | Sa l => arraym.iter (loop' l) x
        | Pair(a,b) => loop' a (fst x) . loop' b (snd x)
        | Wrap (exists b. a, b, p) => loop' p (a x)
        | Alt l =>
            inl end = *i + size p
            real
                open real_core
                push (conv `int (union_tag x)) (union_type_length `t)
                inl offsets, _ =
                    record_fold (fun {state=(m,s) key value} => 
                        typecase `value with pickler ~t => 
                        {m with $key=s}, s + size `t value
                        ) ({},0) (nominal_strip l)
                unbox x fun (k,v) =>
                    advance (offsets k)
                    loop' `(`(v)) (l k) v
            set end
    loop' p x

// Deserializes the argument from a binary vector.
inl unpickle forall array{pickler_index} tt. (ar : array) (p : pickler tt) : tt = join
    inl size : forall w. pickler w -> int = size()
    inl i = stack_mut (0 : int)
    inl index (i' : int) : bool = pickler_index ar (*i + i')
    inl advance i' = i <- *i + i'
    inl parse () : bool =
        inl x = index 0
        advance 1
        x
    inl scan_template (len : int) =
        loop.for {from = 0; nearTo = len} (fun i' (last_loc, count : int * int) =>
            if parse() then i', count + 1
            else last_loc, count
            ) (0, 0)
    inl scan ~(len : int) : int = join
        inl last_loc, count = scan_template len
        assert (count = 1) "The number of integers being scanned in unpickle needs to be exactly 1."
        last_loc
    inl ensure (c : bool) ~(len : int) : () = join
        inl last_loc, count = scan_template len
        if c then assert (count = len) "Expected that the elements of this particular element in the unpickler would all be 1. `ensure` check failed."
        else assert (count = 0) "Expected that the elements of this particular element in the unpickler would all be 0. `ensure` check failed."
    inl set i' = i <- i'
    inl rec loop' forall t. (p : pickler t) : t =
        match p with
        | Unit => ()
        | Bool => scan 2 = 1
        | Int l => 
            assert (l > 0) "The argument to Int must be greater than 0."
            scan l
        | Uint l => 
            assert (l > 0) "The argument to Uint must be greater than 0."
            conv (scan l)
        | Sa_list l =>
            inl max_len = get_max_length p
            inl len = scan max_len
            inl x = sa_create
            loop.for' {from = 0; nearTo = len} fun _ =>
                sa_listm.push x (loop' l) . ensure false 1
            loop.for' {from = len; nearTo = max_len} fun _ =>
                ensure false (size l) . ensure true 1
            x
        | Sa l => sam.init (fun _ => loop' l)
        | Pair(a,b) => loop' a, loop' b
        | Wrap (exists b. a, b, p) => b (loop' p)
        | Alt l =>
            inl result = stack_mut None
            real
                open real_core
                inl tag = scan (union_type_length `t)
                record_fold (fun {state=i key value} => 
                    typecase `value with pickler ~t_case => 
                    if i = tag then
                        match *result with 
                        | None => 
                            union_untag `t (conv `i32 i)
                                (fun k => forall v. => nominal_create `t (k, loop' `v value))
                                (fun _ => error_type "Invalid tag.")
                            |> fun x => result <- Some `t x
                        | Some => assert (dyn false) "Duplicate union type instances in the unpickle Alt case."
                    else
                        ensure false (size `t_case value)
                    i + 1
                    ) 0 (nominal_strip l) |> ignore
            match *result with
            | Some x => x
            | None => failwith "Could not parse the union type in unpickle's Alt case."
    loop' p

inl option forall t. (a : pickler t) : pickler (option t) = alt { Some = a; None = unit() }
inl result forall a b. (a : pickler a) (b : pickler b) : pickler (result a b) = alt { Ok = a; Error = b }
inl (++) forall a b. (a : pickler a) (b : pickler b) : pickler (choice2 a b) = alt { C1of2 = a; C2of2 = b }
inl (**) forall a b. (a : pickler a) (b : pickler b) : pickler (a * b) = pair a b

nominal pickled_array t = binary_array
// nominal pickled_array t = array u8
inl serialize forall t. (p : pickler t) (x : t) : pickled_array t =
    inl size = size()
    inl len = size p
    inl ar : binary_array = pickler_create len
    // inl ar : array u8 = pickler_create len
    loop.for' {from=0; nearTo=len} (fun i => pickler_set ar i false)
    pickle ar p x
    pickled_array ar

inl deserialize forall t. (p : pickler t) (pickled_array x : pickled_array t) : t =
    open tensorm
    unpickle x p

instance printable pickled_array t = fun ({write write_ln} : printable_funs) (pickled_array x) => write_ln x