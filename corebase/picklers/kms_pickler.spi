// Pickler combinators for converting regular Spiral types to binary vectors.
// The preferred pickler for Spherical K-Means dictionaries. I'd also recomment it for regular NNs as well.
// Appends a bias term to the start of the vector automatically.

open hd_pickler

// Returns the number of entries in the pickler.
// Is intended for internal use only.
inl size'() : forall t. pickler t -> int = 
    inl h = compile_time.hashmapm.create()
    inl body forall t. (p : pickler t) : int =
        inl rec loop forall t'. : pickler t' -> int =
            compile_time.hashmapm.memoize h function
                | Unit => 1
                | Bool => 2
                | Int l => assert (l > 0) "The Int length must be greater than 0." . l
                | Uint l => assert (l > 0) "The Uint length must be greater than 0." . l
                | Sa_list p as x => 
                    inl max_len = get_max_length x
                    loop p * max_len
                | Sa p as x =>
                    inl max_len = get_max_length x
                    loop p * max_len
                | Pair(a,b) => loop a + loop b 
                | Wrap (exists b. a, b, p) => loop p 
                | Alt l => real
                    open real_core
                    inl l = nominal_strip l
                    record_fold (fun {state key value} => 
                        typecase `value with pickler ~t => 
                        state + loop `t value
                        ) 0 l
                | Record l => real
                    open real_core
                    inl l = nominal_strip l
                    record_fold (fun {state key value} => 
                        typecase `value with pickler ~t => 
                        state + loop `t value
                        ) 0 l
        loop p
    `$body

// Returns the size of the pickler. Uses a compile time dictionary under the hood that gets created when the union arg is applied.
inl size forall t. (x : pickler t) : int = inl f = size'() in f (unit() ** x)

// Serializes the argument to a binary vector. The vector elements should all be set to 0 prior to being passed into this function.
inl pickle forall array{pickler_set} tt. (ar : array) (p : pickler tt) ~(x : tt) : () = join
    inl p, x = (unit() ** p), ((), x) // Appends a bias term at the start of the vector because the sa_list case might return a fully empty vector.
    inl size : forall w. pickler w -> int = size'()
    inl i = stack_mut (0 : int)
    inl enable i' = pickler_set ar (*i + i') true
    inl advance i' = i <- *i + i'
    inl push a b = enable a . advance b
    inl set i' = i <- i'
    inl rec loop' forall t. (p : pickler t) (x : t) : () = 
        match p with
        | Unit => push 0 1
        | Bool => push (if x then 1 else 0) 2
        | Int l => 
            assert (0 <= x) "The input to the pickler must be 0 or positive."
            assert (x < l) "The input to the pickler must be less than the specified length."
            push x l
        | Uint l =>
            inl x = conv x
            assert (x < l) "The input to the pickler must be less than the specified length."
            push x l
        | Sa_list l =>
            inl max_len = get_max_length p
            inl len = length x
            arraym.iter (fun x => loop' l x) x
            advance (size l * (max_len - len))
        | Sa l => arraym.iter (loop' l) x
        | Pair(a,b) => loop' a (fst x) . loop' b (snd x)
        | Wrap (exists b. a, b, p) => loop' p (a x)
        | Alt l =>
            inl end = *i + size p
            real
                open real_core
                inl offsets, _ =
                    record_fold (fun {state=(m,s) key value} => 
                        typecase `value with pickler ~t => 
                        {m with $key=s}, s + size `t value
                        ) ({},0) (nominal_strip l)
                unbox x fun (k,v) =>
                    advance (offsets k)
                    loop' `(`(v)) (l k) v
            set end
        | Record l =>
            real
                open real_core
                record_iter (fun {key value} => loop' `(`(value)) (l key) value) x
    loop' p x

// Deserializes the argument from a binary vector.
inl unpickle forall array{pickler_index} tt. (ar : array) (p : pickler tt) : tt = join
    inl p = unit() ** p
    inl size : forall w. pickler w -> int = size'()
    inl i = stack_mut (0 : int)
    inl index (i' : int) : bool = pickler_index ar (*i + i')
    inl advance i' = i <- *i + i'
    inl parse () : bool =
        inl x = index 0
        advance 1
        x
    inl scan_template (len : int) =
        loop.for {from = 0; nearTo = len} (fun i' (last_loc, count : int * int) =>
            if parse() then i', count + 1
            else last_loc, count
            ) (0, 0)
    inl scan ~(len : int) : int = join
        inl last_loc, count = scan_template len
        assert (count = 1) "The number of integers being scanned in unpickle needs to be exactly 1."
        last_loc
    inl has_nonzero ~(len : int) : bool = join
        inl last_loc, count = scan_template len
        advance -len
        count > 0
    inl ensure (c : bool) ~(len : int) : () = join
        inl last_loc, count = scan_template len
        if c then assert (count = len) "Expected that the elements of this particular element in the unpickler would all be 1. `ensure` check failed."
        else assert (count = 0) "Expected that the elements of this particular element in the unpickler would all be 0. `ensure` check failed."
    inl set i' = i <- i'
    inl rec loop' forall t. (p : pickler t) : t =
        match p with
        | Unit => assert (scan 1 = 0) "Invalid unit value in unpickle."
        | Bool => scan 2 = 1
        | Int l => scan l
        | Uint l => conv (scan l)
        | Sa_list l =>
            inl max_len = get_max_length p
            inl x = sa_create
            inl is_done = stack_mut false
            loop.for' {from = 0; nearTo = max_len} fun _ =>
                inl size = size l
                if *is_done then
                    ensure false size
                else 
                    if has_nonzero size then
                        sa_listm.push x (loop' l)
                    else
                        advance size
                        is_done <- true
            x
        | Sa l => sam.init (fun _ => loop' l)
        | Pair(a,b) => loop' a, loop' b
        | Wrap (exists b. a, b, p) => b (loop' p)
        | Alt l =>
            inl result = stack_mut None
            inl is_done = stack_mut false
            real
                open real_core
                record_fold (fun {state=i key value} => 
                    typecase `value with pickler ~t_case => 
                    inl size = size `t_case value
                    if *is_done then
                        ensure false size
                    else
                        if has_nonzero size then
                            match *result with 
                            | None => 
                                union_untag `t (conv `i32 i)
                                    (fun k => forall v. => nominal_create `t (k, loop' `v value))
                                    (fun _ => error_type "Invalid tag.")
                                |> fun x => result <- Some `t x
                            | Some => assert (dyn false) "Duplicate union type instances in the unpickle Alt case."
                            is_done <- true
                        else
                            advance size
                    i + 1
                    ) 0 (nominal_strip l) |> ignore
            match *result with
            | Some x => x
            | None => failwith "Could not parse the union type in unpickle's Alt case."
        | Record l =>
            real
                open real_core
                record_map (fun {key value} => 
                    typecase `value with pickler ~t_case => 
                    loop' `t_case value
                    ) (nominal_strip l)
    loop' p |> snd

nominal kms_pickled_array t = binary_array
// nominal kms_pickled_array t = array u8
inl serialize forall t. (p : pickler t) (x : t) : kms_pickled_array t =
    inl len = size p
    inl ar : binary_array = pickler_create len
    // inl ar : array u8 = pickler_create len
    loop.for' {from=0; nearTo=len} (fun i => pickler_set ar i false)
    pickle ar p x
    kms_pickled_array ar

inl deserialize forall t. (p : pickler t) (kms_pickled_array x : kms_pickled_array t) : t =
    unpickle x p

instance printable kms_pickled_array t = fun ({write write_ln} : printable_funs) (kms_pickled_array x) => write_ln x