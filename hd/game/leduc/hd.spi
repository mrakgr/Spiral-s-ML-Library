// A Winner-Take-All Hebbian dictionary implementation using the Arrayfire library.
open corebase
open af

nominal af_index k = k * af_array u32
inl max_dictionary_get forall t.
        (x : stack_refs {
            keys : af_array t
            values : af_array t
            input : af_array t
            out_values : af_array t
            out_indices : af_array u32
        }) : () = join
    inl {keys values input out_values out_indices} = *x
    inl temp : af_array t = $"af::matmul(af::transpose(!input), !keys)"
    inl max_vals : af_array t = $"af::array \v"
    $"af::max(!max_vals, !out_indices, !temp + af::randu(!temp.dims()), 1)"
    $"!out_values = af::lookup(!values, !out_indices, 1)"

type serializers k v = exists t{number}. 
    { 
        key_to_array : k -> af_array t
        array_to_value : af_array t -> v 
        value_to_array : v -> af_array t
        array_to_key : af_array t -> option k
    }
nominal dict k v =
    exists t{number}. {
        data : stack_refs {
            keys : af_array t
            values : af_array t
        }
        serializers : { 
            key_to_array : k -> af_array t
            value_to_array : v -> af_array t
            array_to_value : af_array t -> v 
            array_to_key : af_array t -> option k
        }
    }

// Creates the dictionary with a specified types `k` for the keys and `v` for values. `t` represents the matrix datatype.
// Takes in serializers to convert raw array data of type `t` to Spiral usable formats.
// The rows and the columns need to be compile time literals.
// Does not initialize the matrices to 0.
inl create forall k v. (exists t. { key_to_array array_to_value value_to_array array_to_key } : serializers k v) ({rows cols_keys cols_values} : {rows : int; cols_keys : int; cols_values : int}) : dict k v =
    dict (exists [t] {
        serializers = { key_to_array array_to_value value_to_array array_to_key }
        data = stack_refs {
            keys = create {rows cols = cols_keys}
            values = create {rows cols = cols_values}
        }
    })

// Clears the dictionary of keys by setting both the keys and the values all to 0.
inl clear forall k v. ((dict (exists t. {data = refs})) : dict k v) : () =
    matrix_set_all refs.keys 1 . matrix_clear refs.values

// Gets an item from the dictionary.
inl get forall k v. ((dict (exists t. {serializers data = refs})) : dict k v) (k : k) : v * af_index k =
    inl input = serializers.key_to_array k
    inl values : af_array t = $"af::array \v"
    inl indices : af_array u32 = $"af::array \v"
    max_dictionary_get (stack_refs {
        keys = refs.keys
        values = refs.values
        input = input
        out_values = values
        out_indices = indices
    })
    serializers.array_to_value values, af_index (k, indices)

// Returns the number of rows in a dictionary
inl num_rows forall k v. ((dict (exists t. {serializers data = refs})) : dict k v) : int =
    matrix_rows refs.keys

// Added the key value pair to the dictionary and increments the dictionary pointer by one.
inl set forall k v. ((dict (exists t. {serializers data = refs})) & d : dict k v) (af_index (k, k_i) : af_index k) (v : v) : () =
    inl num_rows : int = num_rows d
    inl keys, values = refs.keys, refs.values
    $"!keys(af::span, !k_i) = !(serializers.key_to_array k)"
    $"!values(af::span, !k_i) = !(serializers.value_to_array v)"

// Iterates over the dictionary with the iterator function.
inl iter forall k v. (f : k -> v -> ()) ((dict (exists t. {serializers data = refs})) & d : dict k v) : () =
    inl num_rows : int = num_rows d
    inl keys, values = refs.keys, refs.values
    loop.for' {from = 0; nearTo = num_rows} fun i =>
        inl k = ($"auto \v = !keys(af::span, !i)" : af_array t) |> serializers.array_to_key
        match k with
        | Some k => 
            inl v = ($"auto \v = !values(af::span, !i)" : af_array t) |> serializers.array_to_value
            f k v
        | None => ()

instance printable dict k v = fun {write write_ln} d =>
    write_ln "{"
    iter (fun k v => write k . write " => " . write_ln v) d
    write_ln "}"