// Spherical K-Means dictionary implementation using the Arrayfire library.
open corebase
open af

inl learning_rate () = 0.1

nominal af_index k = k * af_array u32
inl spherical_kms_dictionary_get forall t.
        (refs_in : stack_refs {
            keys : af_array t
            values : af_array t
            input : af_array t
        }) 
        (refs_out : stack_refs {
            indexed_values : af_array t
            max_indices : af_array u32
        }) : () = join
    inl {keys values input} = *refs_in
    inl {indexed_values max_indices} = *refs_out
    inl temp : af_array t = $"af::matmul(af::transpose(!input), !keys)"
    inl max_vals : af_array t = $"af::array \v"
    $"af::max(!max_vals, !max_indices, !temp, 1)"
    $"!indexed_values = af::lookup(!values, !max_indices, 1)"

inl normalize_l2 forall t. (keys : af_array t) : af_array t = $"!keys / af::tile(af::sqrt(af::sum(!keys * !keys, 0)), !keys.dims(0))"

inl spherical_kms_dictionary_key_update forall t.
        (lr : float)
        (refs_in : stack_refs {
            input : af_array t
            max_indices : af_array u32
        }) 
        (refs_io : stack_refs {
            keys : af_array t
        }) 
        : () = join
    inl {input max_indices} = *refs_in
    inl {keys} = *refs_io
    inl input = normalize_l2 input
    inl dim_inner : int = $"!input.dims(0)"
    inl indexed_keys : af_array t = $"af::lookup(!keys, !max_indices, 1)"
    inl indexed_keys_update : af_array t = $"!input - af::tile(af::sum(!input * !indexed_keys, 0), !dim_inner) * !indexed_keys"
    inl indexed_keys_updated : af_array t = normalize_l2 $"!indexed_keys + !lr * !indexed_keys_update"
    $"!keys(af::span, !max_indices) = !indexed_keys_updated"
    
inl spherical_kms_dictionary_value_update forall t.
        (refs_in : stack_refs {
            value : af_array t
            max_indices : af_array u32
        }) 
        (refs_io : stack_refs {
            values : af_array t
        }) 
        : () = join
    inl {value max_indices} = *refs_in
    inl {values} = *refs_io
    $"!values(af::span, !max_indices) = !value"

type serializers k v = exists t{number}. 
    { 
        key_to_array : k -> af_array t
        array_to_value : af_array t -> v 
        value_to_array : v -> af_array t
    }
nominal dict k v =
    exists t{number}. {
        data : stack_refs {
            keys : af_array t
            values : af_array t
        }
        serializers : { 
            key_to_array : k -> af_array t
            value_to_array : v -> af_array t
            array_to_value : af_array t -> v 
        }
    }

// Creates the dictionary with a specified types `k` for the keys and `v` for values. `t` represents the matrix datatype.
// Takes in serializers to convert raw array data of type `t` to Spiral usable formats.
// The rows and the columns need to be compile time literals.
// Does not initialize the matrices to 0.
inl create forall k v. (exists t. { key_to_array array_to_value value_to_array } : serializers k v) ({rows cols_keys cols_values} : {rows : int; cols_keys : int; cols_values : int}) : dict k v =
    dict (exists [t] {
        serializers = { key_to_array array_to_value value_to_array  }
        data = stack_refs {
            keys = create {rows cols = cols_keys}
            values = create {rows cols = cols_values}
        }
    })

// Clears the dictionary of keys by setting both the keys and the values all to 0.
inl clear forall k v. ((dict (exists t. {data = refs})) : dict k v) : () =
    inl rows, cols = matrix_rows refs.keys, matrix_cols refs.keys
    inl keys : af_array t = normalize_l2 $"af::randu(!cols, !rows)"
    $"!(refs.keys) = !keys"
    matrix_clear refs.values

// Gets an item from the dictionary.
inl get forall k v. ((dict (exists t. {serializers data = refs})) : dict k v) (k : k) : v * af_index k =
    inl input = serializers.key_to_array k
    inl indexed_values : af_array t = $"af::array \v"
    inl max_indices : af_array u32 = $"af::array \v"
    spherical_kms_dictionary_get 
        (stack_refs { keys = refs.keys; values = refs.values; input })
        (stack_refs { indexed_values max_indices })
    // spherical_kms_dictionary_key_update
    //     learning_rate()
    //     (stack_refs { input max_indices })
    //     (stack_refs { keys = refs.keys })
    serializers.array_to_value indexed_values, af_index (k, max_indices)

// Returns the number of rows in a dictionary
inl num_rows forall k v. ((dict (exists t. {serializers data = refs})) : dict k v) : int =
    matrix_rows refs.keys

// Added the key value pair to the dictionary and increments the dictionary pointer by one.
inl set forall k v. ((dict (exists t. {serializers data = refs})) & d : dict k v) (af_index (_, max_indices) : af_index k) (v : v) : () =
    inl num_rows : int = num_rows d
    inl keys, values = refs.keys, refs.values
    inl value = $"!(serializers.value_to_array v)"
    spherical_kms_dictionary_value_update
        (stack_refs { value max_indices })
        (stack_refs { values })
