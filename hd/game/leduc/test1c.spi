// The integer pickler serialization test.

open corebase
open corecuda
open picklers
open int_pickler
open coreext

union card = King | Queen | Jack
union action = Raise : int | Fold | Call

type game_state = {
    stack : uint
    pot : int
    is_first : bool
    card : card
    action_history : sa_list 5 action
    l : sa 3 int
    }

inl program() =
    inl p_card : pickler card = alt {
        King = unit()
        Queen = unit()
        Jack = unit()
    }
    inl p_action : pickler action = alt {
        Raise = Int 3
        Fold = unit()
        Call = unit()
    }
    inl p_record = record {
        action = p_action
        card = p_card
    }
    inl p : pickler (sa_list 5 ({action : action; card : card}) * sa 2 int) = 
        sa_list p_record ** sa (int 5)
    console.write_ln {size = size p}
    loop.for' {from = 0; nearTo = size p} fun i =>
        inl i = int_pickled_array i
        assert (serialize p (deserialize p i) = i) "The round trip has to be equal to the original."
    console.write_ln "The test passes."

inl main() =
    inl python () = 
        run_cuda_device_from_python fun _ =>
            if rangem.threads_in_grid().from = 0 then
                program()
        device_sync()
    // inl cpp () =
    //     run_cuda_host_from_cpp_host fun _ =>
    //         run_cuda_device_from_cuda_host fun _ =>
    //             if rangem.threads_in_grid().from = 0 then
    //                 program()
    //         device_sync()
    inl cpp () = program()
    real real_core.backend_switch_unsafe { Python = python; CppHost = cpp }
    0i32
