open corebase
open corecuda
open coreext

inl main() =
    run fun () =>
        if rangem.threads_in_grid().from = 0 then
            // inl ~y = 2
            // inl f (x : int) = x + y
            inl f (x,y : int * int) = x + y
            inl ~f = to_closure f
            inl g x = f x
            inl ~g = to_closure g
            inl ~r = g(1,2)
            console.write_ln r
            ()