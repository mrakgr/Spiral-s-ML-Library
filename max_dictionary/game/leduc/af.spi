open corebase
nominal af_array t = $"af::array \@ \#include <arrayfire.h>"

prototype array_index m t : m t -> (int * int) -> t
prototype array_rows m t : m t -> int
prototype array_cols m t : m t -> int
prototype array_set m t : m t -> (int * int) -> t -> ()
prototype array_clear m t : m t -> ()

inl globals() = global "#include <arrayfire.h>"

// Creates a new af::array with specified dimensions (column-major order)
// Note: Arrayfire uses column-major order, so we specify (cols, rows) to the constructor
inl create forall t{number}. ({rows cols} : {rows : int; cols : int}) : af_array t = 
    $"`(af_array t) \v(!cols, !rows)"

instance array_index af_array = fun m (r,c) => $"!m(!r,!c)"
instance array_rows af_array = fun m => $"!m.dims(1)"
instance array_cols af_array = fun m => $"!m.dims(0)"
instance array_set af_array = fun m (r,c) v => $"!m(!r,!c) = !v"
instance array_clear af_array = fun m => $"!m = af::constant(0, !m.dims(), !m.type())"
