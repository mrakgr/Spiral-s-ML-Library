// Test for the maxi module (Arrayfire max dictionary)
open corebase
open af
open maxi

// Simple serializers for testing with float arrays
inl serializers_float : serializers (array f32) (array f32) = 
    exists f32.  
        { 
            key_to_array = fun (k : array f32) => 
                inl len = array_length k
                inl result : af_array f32 = create {rows = len; cols = 1}
                loop.for' {from = 0; nearTo = len} fun i =>
                    $"!result(!i, 0) = !k[!i]"
                result
            array_to_value = fun (a : af_array f32) => 
                inl len : int = array_rows a
                inl result : array f32 = array_create len
                loop.for' {from = 0; nearTo = len} fun i =>
                    result i <- $"!a(!i, 0)" : f32
                result
            value_to_array = fun (v : array f32) => 
                inl len = array_length v
                inl result : af_array f32 = create {rows = len; cols = 1}
                loop.for' {from = 0; nearTo = len} fun i =>
                    $"!result(!i, 0) = !v[!i]"
                result
            array_to_key = fun (a : af_array f32) => 
                inl len : int = array_rows a
                inl result : array f32 = array_create len
                loop.for' {from = 0; nearTo = len} fun i =>
                    result i <- $"!a(!i, 0)" : f32
                // Check if all values are zero
                inl all_zero = loop.for' {from = 0; nearTo = len; state = true} fun {state i} =>
                    state && result i = 0.0f32
                if all_zero then None else Some result
        }

inl main() : i32 =
    open real_core
    globals()
    console.write_ln "Testing Arrayfire Max Dictionary..."
    
    // Create dictionary with 3 rows, 4 key columns, 4 value columns
    inl d = create serializers_float {rows = 3; cols_keys = 4; cols_values = 4}
    
    // Set some test keys and values
    inl key1 = am [1.0f32; 1.0f32; 0.0f32; 0.0f32]
    inl val1 = am [0.5f32; 0.0f32; 0.5f32; 0.0f32]
    
    inl key2 = am [1.0f32; 0.0f32; 1.0f32; 0.0f32]
    inl val2 = am [0.0f32; 0.75f32; 0.25f32; 0.0f32]
    
    inl key3 = am [0.0f32; 1.0f32; 1.0f32; 1.0f32]
    inl val3 = am [0.666f32; 0.0f32; 0.334f32; 0.0f32]
    
    set d key1 val1
    set d key2 val2
    set d key3 val3
    
    console.write_ln "Dictionary created and populated with 3 entries"
    
    // Test retrieval
    console.write_ln "\nTesting retrieval with key1:"
    inl result1 = get d key1
    console.write "Result: "
    loop.for' {from = 0; nearTo = array_length result1} fun i =>
        console.write result1.[i]
        console.write " "
    console.write_ln ""
    
    console.write_ln "\nTesting retrieval with key2:"
    inl result2 = get d key2
    console.write "Result: "
    loop.for' {from = 0; nearTo = array_length result2} fun i =>
        console.write result2.[i]
        console.write " "
    console.write_ln ""
    
    console.write_ln "\nTest completed successfully!"
    0i32
