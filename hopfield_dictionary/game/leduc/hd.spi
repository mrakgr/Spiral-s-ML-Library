// A Hopfield dictionary implementation using the Eigen library.
open corebase
open eigen

// out = ((keys * input.transpose() - input.rowwise().sum().transpose().replicate(keys.rows(),1)).array() / temperature).exp().matrix().transpose() * values;
inl hopfield_dictionary_get forall rows_hd rows_input cols_keys cols_values t_keys t_values.
        (keys : ref (static_matrix rows_hd cols_keys t_keys))
        (values : ref (static_matrix rows_hd cols_values t_values))
        (input : ref (static_matrix rows_input cols_keys t_keys))
        (out : ref (static_matrix rows_input cols_values t_values))
        (temperature : t_values)
        : () = join
    $"!out = ((!keys * !input.transpose() - !input.rowwise().sum().transpose().replicate(!keys.rows(),1)).array() / !temperature).exp().matrix().transpose() * !values"

type serializers k v = exists cols_keys cols_values t{number}. 
    { 
        key_to_array : k -> static_vector cols_keys t
        array_to_value : static_vector cols_values t -> v 
        value_to_array : v -> static_vector cols_values t
        array_to_key : static_vector cols_keys t -> option k
    }
nominal dict k v = // TODO: The premise behind the bug is incorrect. While I fixed the bug in v2.18.3, `k` and `v` were used in the body. So why didn't the pass work?
    exists rows cols_keys cols_values t{number}. {
        data : stack_refs {
            keys : static_matrix rows cols_keys t
            values : static_matrix rows cols_values t
            i : int
        }
        serializers : { 
            key_to_array : k -> static_vector cols_keys t
            value_to_array : v -> static_vector cols_values t
            array_to_value : static_vector cols_values t -> v 
            array_to_key : static_vector cols_keys t -> option k
        }
    }

// Creates the dictionary with a specified types `k` for the keys and `v` for values. `t` represents the matrix datatype.
// Takes in serializers to convert raw array data of type `t` to Spiral usable formats.
// The rows and the columns need to be compile time literals.
// Does not initialize the matrices to 0.
inl create forall k v. (exists cols_keys cols_values t. { key_to_array array_to_value value_to_array array_to_key } : serializers k v) ({rows} : {rows : int}) : dict k v =
    assert (lit_is rows) "The rows of the matrix have to be known at compile time."
    inl (exists rows. rows) = tint rows
    dict (exists [rows; cols_keys; cols_values; t] {
        serializers = { key_to_array array_to_value value_to_array array_to_key }
        data = stack_refs {
            keys = create_static
            values = create_static
            i = 0
        }
    })

// Clears the dictionary of keys by setting both the keys and the values all to 0.
inl clear forall k v. ((dict (exists rows cols_keys cols_values t. {data = refs})) : dict k v) : () =
    matrix_clear refs.keys . matrix_clear refs.values . refs.i <- 0

// Gets an item from the dictionary.
inl get forall k v. ((dict (exists rows cols_keys cols_values t. {serializers data = refs})) : dict k v) (k : k) : v =
    inl input = serializers.key_to_array k
    inl out = eigen.create_static
    open corecuda.refm
    hopfield_dictionary_get (from_local refs.keys) (from_local refs.values) (from_local input) (from_local out) 0.001
    serializers.array_to_value out

// Returns the number of rows in a dictionary
inl num_rows forall k v. ((dict (exists rows cols_keys cols_values t. {serializers data = refs})) : dict k v) : int =
    real open real_core in type_lit_to_lit `rows : int

// Added the key value pair to the dictionary and increments the dictionary pointer by one.
inl set forall k v. ((dict (exists rows cols_keys cols_values t. {serializers data = refs})) & d : dict k v) (k : k) (v : v) : () =
    inl num_rows : int = num_rows d
    inl keys, values = refs.keys, refs.values
    $"!keys.row(!(refs.i)) = !(serializers.key_to_array k)"
    $"!values.row(!(refs.i)) = !(serializers.value_to_array v)"
    refs.i <- (*refs.i + 1) % num_rows

// Iterates over the dictionary with the iterator function.
inl iter forall k v. (f : k -> v -> ()) ((dict (exists rows cols_keys cols_values t. {serializers data = refs})) & d : dict k v) : () =
    inl num_rows : int = num_rows d
    inl keys, values = refs.keys, refs.values
    loop.for' {from = 0; nearTo = num_rows} fun i =>
        inl k = ($"auto \v = !keys.row(!i)" : static_vector cols_keys t) |> serializers.array_to_key
        inl v = ($"auto \v = !values.row(!i)" : static_vector cols_values t) |> serializers.array_to_value
        match k with
        | Some k => f k v
        | None => ()

instance printable dict k v = fun {write write_ln} d =>
    write_ln "{"
    iter (fun k v => write k . write " => " . write_ln v) d
    write_ln "}"