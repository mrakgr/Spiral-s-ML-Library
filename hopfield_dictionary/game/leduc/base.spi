open corebase
open corecuda
open coreext
open console
open sampling

union card = King | Queen | Jack
union action = Raise | Call | Fold
union message =
    | PlayerGotCard : int * card
    | CommunityCardIs : card
    | PlayerAction : int * action
    | Showdown : {winner_id : int; chips_won : int; cards_shown : sa 2 card}
type messages = sa_list 32 message

inl u32_to_card (i : u32) =
    match i with
    | 0 | 1 => King
    | 2 | 3 => Queen
    | 4 | 5 => Jack
    | _ => failwith "Invalid int in int_to_card."

// Draws a single card from a deck.
let draw_card rng deck : card * deck =
    inl (deck d) = deck
    inl base = random.u32_ubound conv(popc_u32 d) rng
    inl i = sample_masked_bit_u32 d (conv base)
    u32_to_card i, deckm.toggle deck (conv i)

// Draws an array of cards from a deck.
let draw_cards forall dim. rng deck : sa dim card * deck =
    open sam
    inl out : sa dim card = sa_create
    out, loop.for {from=0; nearTo=length out} (fun i deck =>
        inl card, deck = draw_card rng deck
        set out i card
        deck
        ) deck
