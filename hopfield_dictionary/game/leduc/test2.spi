open corebase
open corecuda
open hd_pickler
open coreext

union card = King | Queen | Jack
union action = Raise : int | Fold | Call
inl actions() = Fold :: Call :: listm.init 10 Raise

type game_state = 
    {
        stack : uint
        pot : int
        is_first : bool
        card : card
        action_history : sa_list 5 action
        l : sa 3 int
    }

type num_actions = 12
type game_dicts = 
    {
        average_policy : sa num_actions float
        current_policy : sa num_actions float
        ev_values : sa num_actions float
        ev_weights : sa num_actions float
    }

inl main() =
    inl size = hd_pickler.size()
    inl p_card = alt {
        King = unit()
        Queen = unit()
        Jack = unit()
    }
    inl p_action = alt {
        Raise = Int 10
        Fold = unit()
        Call = unit()
    }
    inl num_actions : int = actions() |> listm.length
    inl (exists num_actions'. _) = tint num_actions
    assert (if type num_actions = num_actions' then true else false) "The number of actions in the pickler have to be equal to the global specification."
    inl p : pickler game_state = 
        uint 10 ** int 10 ** bool() ** p_card ** sa_list p_action ** sa (int 5)
        |> wrap 
            (fun {stack pot is_first card action_history l} => stack, pot, is_first, card, action_history, l)
            (fun stack, pot, is_first, card, action_history, l => {stack pot is_first card action_history l})

    inl serializers : hd.serializers game_state game_dicts = 
        inl (exists cols_keys. _) = tint (size p)
        inl (exists cols_values. _) = tint (num_actions * 4)
        exists [cols_keys; cols_values; float] 
            {
                key_to_array = fun x =>
                    inl m : eigen.static_vector cols_keys float = eigen.create_static
                    eigen.matrix_clear m
                    inl ar : array float = $"&!m(0,0)"
                    hd_pickler.pickle ar p x  
                    m
                array_to_value = fun x => 
                    inl init offset = sam.init (fun i => eigen.matrix_index x (0, i + offset))
                    {
                        average_policy = init (num_actions * 0)
                        current_policy = init (num_actions * 1)
                        ev_values = init (num_actions * 2)
                        ev_weights = init (num_actions * 3)
                    }
            }
            
    inl d : hd.dict game_state game_dicts = hd.create serializers {rows=1 <<< 0}
    inl k : game_state = {stack=5; pot=8; is_first = false; card=King; action_history=arraym.fromList [Raise 3; Raise 4; Call; Fold]; l = arraym.fromList [1;2;3]}
    inl v : game_dicts = hd.get d k
    console.write_ln v
    0i32