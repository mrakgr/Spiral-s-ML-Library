open corebase
open coreext
open console
open cardm

inl create () = deck ((1 <<< 6) - 1)
inl index (deck d) i : bool = d &&& (1 <<< i) <> 0
inl toggle (deck d) i : deck = deck (d ^^^ (1 <<< i))

let find_nth_set_bit (mask : u32) (base : u32) (offset : i32) : u32 =
    backend_switch_cuda {
        CudaHost = fun () =>
            inl masked_bits = mask >>> conv base
            inl count = stack_mut 0i32
            inl solution = stack_mut limit.max
            loop.for' {from=0; nearTo=32 - base} fun i =>
                if (masked_bits >>> conv i) &&& 1 <> 0 then
                    inl c = @count + 1
                    count <- c
                    if c = offset then
                        solution <- base + i
                        $"break"
            @solution
        CudaDevice = fun () =>
            corecuda.intrinsic.fns mask base offset
    }

