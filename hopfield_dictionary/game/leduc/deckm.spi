open corebase
open coreext
open console
open cardm

inl create () = deck ((1 <<< 6) - 1)
inl index (deck d) i : bool = d &&& (1 <<< i) <> 0
inl toggle (deck d) i : deck = deck (d ^^^ (1 <<< i))

// def find_nth_set_bit(mask, base, offset):
//     # Consider bits starting from 'base'
//     masked_bits = mask >> base
//     count = 0
//     for i in range(32 - base):
//         if masked_bits & (1 << i):
//             count += 1
//             if count == offset:
//                 return base + i
//     return 0xFFFFFFFF  # Not found

let find_nth_set_bit (mask : i32) (base : i32) (offset : i32) : i32 =
    inl masked_bits = mask >>> base
    inl count = mut 0i32
    inl solution = mut (limit.min : i32)
    loop.for' {from=0; nearTo=32 - base} fun i =>
        if masked_bits &&& (1 <<< i) <> 0 then
            inl c = *count
            count <- c + 1
            if c = offset then
                solution <- base + i
                $"break"
    *solution

