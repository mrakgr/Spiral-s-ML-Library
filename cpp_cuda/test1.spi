open corebase
open corecuda
open coreext
open rangem

inl main() : int =
    inl x : array int = ;[1;2;3;4]
    console.write_ln {
        message = "hello from host"
        length_of_array = length x
        index_2 = index x 2
    }
    run (fun _ =>
        inl ~y : int = index x 0 + index x 1
        if threads_in_grid().from = 0 then
            console.write_ln {
                message = "hello from cuda"
                result = y
                }
        ()
        )
    device_sync()
    0